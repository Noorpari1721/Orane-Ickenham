generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id         String         @id @default(cuid())
  customerNo String         @unique
  firstName  String
  lastName   String
  email      String         @unique
  phone      String?
  status     CustomerStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  bookings   Booking[]
  payments   Payment[]

  @@index([lastName])
  @@index([phone])
}

model Tech {
  id          String     @id @default(cuid())
  techNo      String     @unique
  firstName   String
  lastName    String
  email       String?    @unique
  phone       String?
  role        String?
  experience  Int        @default(0)
  specialties String[]
  status      TechStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookings    Booking[]
}

model Service {
  id               String            @id @default(cuid())
  serviceNo        String            @unique
  name             String
  category         String
  description      String?
  duration         Int
  price            Decimal           @db.Decimal(10, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  bookingServices  BookingService[]
  giftCards        GiftCard[]
  giftCardServices GiftCardService[]

  @@index([category])
  @@index([active])
}

model Booking {
  id                 String           @id @default(cuid())
  bookingNo          String           @unique
  date               DateTime
  startTime          String
  endTime            String?
  status             BookingStatus    @default(PENDING)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customerId         String
  serviceId          String
  techId             String?
  consultationStatus String?
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service            Service          @relation(fields: [serviceId], references: [id])
  tech               Tech?            @relation(fields: [techId], references: [id])
  bookingServices    BookingService[]
  payment            Payment?

  @@index([date])
  @@index([customerId])
  @@index([serviceId])
  @@index([techId])
  @@index([status])
}

model BookingService {
  id        String   @id @default(cuid())
  bookingId String
  serviceId String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNo     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookingId     String        @unique
  customerId    String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SalonSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalonWorkingHour {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isOpen    Boolean  @default(true)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftCard {
  id                  String               @id @default(cuid())
  giftCardNo          String               @unique
  code                String               @unique
  type                GiftCardType
  status              GiftCardStatus       @default(PENDING)
  amount              Decimal              @db.Decimal(10, 2)
  remainingAmount     Decimal              @db.Decimal(10, 2)
  serviceId           String?
  purchaserFirstName  String?
  purchaserLastName   String?
  purchaserEmail      String?
  recipientFirstName  String?
  recipientLastName   String?
  recipientEmail      String?
  personalMessage     String?
  stripeSessionId     String?              @unique
  stripePaymentIntent String?              @unique
  issuedAt            DateTime?
  paidAt              DateTime?
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  service             Service?             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  redemptions         GiftCardRedemption[]
  giftCardServices    GiftCardService[]

  @@index([status])
  @@index([type])
  @@index([expiresAt])
  @@index([recipientEmail])
  @@index([createdAt])
}

model GiftCardService {
  id         String   @id @default(cuid())
  giftCardId String
  serviceId  String
  createdAt  DateTime @default(now())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([giftCardId, serviceId])
  @@index([giftCardId])
  @@index([serviceId])
}

model GiftCardRedemption {
  id           String   @id @default(cuid())
  redemptionNo String   @unique
  giftCardId   String
  amount       Decimal  @db.Decimal(10, 2)
  redeemedAt   DateTime @default(now())
  notes        String?
  giftCard     GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([redeemedAt])
}

model Admin {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  STRIPE
  CASH
  CARD
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TechStatus {
  AVAILABLE
  UNAVAILABLE
}

enum GiftCardType {
  SERVICE_VOUCHER
  CUSTOM_GIFT_CARD
}

enum GiftCardStatus {
  PENDING
  ACTIVE
  PARTIALLY_REDEEMED
  REDEEMED
  EXPIRED
  CANCELLED
}
